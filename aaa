-- Junk + RLO (สั้น)
-- ===============================
local _RLO = string.char(226, 128, 174)  -- ✅ ปลอดภัย
local _JUNK_RAW = 
local _JUNK_SUFFIX_RAW =
local _JUNK_PREFIX = _JUNK_RAW:gsub("%(RLO%)", _RLO)
local _JUNK_SUFFIX = _JUNK_SUFFIX_RAW:gsub("%(RLO%)", _RLO)

